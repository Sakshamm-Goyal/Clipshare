<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dawn_sky">

    <ImageView
        android:id="@+id/background_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/quiet_dawn_connection" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingTop="30dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp"
        tools:context=".ui.MainActivity">

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ClipShare"
        android:textColor="@color/dawn_ink"
        android:textSize="36sp"
        android:fontFamily="sans-serif-light"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pill"
        android:text="Mac connected"
        android:textAlignment="center"
        android:textColor="@color/dawn_mint"
        android:textSize="15sp"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_text" />

    <View
        android:id="@+id/preview_surface"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_preview"
        android:layout_marginTop="42dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_text" />

    <TextView
        android:id="@+id/preview_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Clipboard ready"
        android:textColor="@color/dawn_ink"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="@id/preview_surface"
        app:layout_constraintEnd_toEndOf="@id/preview_surface"
        app:layout_constraintTop_toTopOf="@id/preview_surface"
        android:layout_marginStart="22dp"
        android:layout_marginTop="22dp" />

    <TextView
        android:id="@+id/preview_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Text or image will be sent securely"
        android:textColor="@color/dawn_muted"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/preview_label"
        app:layout_constraintEnd_toEndOf="@id/preview_surface"
        app:layout_constraintTop_toBottomOf="@id/preview_label"
        android:layout_marginTop="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Start secure sync"
        android:textSize="17sp"
        android:textColor="@color/dawn_ink"
        android:backgroundTint="@color/dawn_blue"
        android:textAllCaps="false"
        android:layout_marginTop="26dp"
        android:enabled="false"
        app:cornerRadius="28dp"
        app:strokeColor="@color/dawn_blue_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preview_surface" />

    <Button
        android:id="@+id/stop_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="Pause sync"
        android:textColor="@color/dawn_muted"
        android:textSize="14sp"
        android:background="@android:color/transparent"
        android:minHeight="0dp"
        android:textAllCaps="false"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sync_now_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sync_now_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Send to Mac"
        android:textColor="@color/dawn_ink"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:backgroundTint="@color/dawn_blue"
        android:textAllCaps="false"
        android:layout_marginTop="26dp"
        android:enabled="false"
        app:cornerRadius="28dp"
        app:strokeColor="@color/dawn_blue_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preview_surface" />

    <Button
        android:id="@+id/battery_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="Battery settings"
        android:textColor="@color/dawn_muted"
        android:textSize="14sp"
        android:background="@android:color/transparent"
        android:minHeight="0dp"
        android:textAllCaps="false"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stop_button" />

    <Button
        android:id="@+id/pair_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="Pair or manage Mac"
        android:textColor="@color/dawn_muted"
        android:textSize="14sp"
        android:background="@android:color/transparent"
        android:minHeight="0dp"
        android:textAllCaps="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/battery_button" />

    <TextView
        android:id="@+id/info_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Android → Mac, private by design"
        android:textAlignment="center"
        android:textSize="12sp"
        android:textColor="@color/dawn_muted"
        android:layout_marginTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
